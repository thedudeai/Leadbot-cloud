# ---- Required ----
# First admin account. Only used when there are no accounts yet.
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Your Name

# Claude: run `claude setup-token` on a machine signed in to the company's
# Claude account and paste the token here. One account does all the profiling.
CLAUDE_CODE_OAUTH_TOKEN=

# Zoho CRM self-client credentials (same three values as data/zoho.json before).
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---- Optional ----
# Where users, history and run results live. Mount a volume here in production.
DATA_DIR=/data
PORT=8080
